  "npcs": [
    {
      "id": "npc_ibu",
      "name": "Ibu",
      "role": "Ibu Rumah Tangga",
      "assetId": "npc_sheet_family",
      "color": 14450338,
      "x": 20,
      "y": 13.5,
      "dialog": "Selamat pagi Budi! Ibu sudah siapkan sarapan di meja makan. Jangan lupa sarapan sebelum berangkat sekolah ya!",
      "choices": [
        {
          "id": "sarapan",
          "label": "\ud83c\udf73 Sarapan di Meja Makan",
          "reply": "Makanlah sampai kenyang nak, supaya energimu penuh untuk belajar seharian!"
        },
        {
          "id": "uang_saku",
          "label": "\ud83d\udcb5 Minta Uang Saku Harian",
          "reply": "Ini uang saku Rp20.000 untuk hari ini. Gunakan dengan bijak dan catat di buku kas ya!"
        },
        {
          "id": "pamit",
          "label": "\ud83c\udf92 Pamit Berangkat Sekolah",
          "reply": "Hati-hati di jalan ya nak, rajinlah belajar!"
        }
      ],
      "dialogId": "dia_ibu_home"
    },
    {
      "id": "npc_ayah",
      "name": "Ayah",
      "role": "Kepala Keluarga",
      "assetId": "npc_sheet_family",
      "color": 4359850,
      "x": 12,
      "y": 15.5,
      "dialog": "Halo nak! Sebelum jajan atau belanja, selalu cek menu Anggaran di HUD atas. Sisihkan tabungan lebih dulu!",
      "choices": [
        {
          "id": "tips_investasi",
          "label": "\ud83d\udcc8 Tanya Tips Finansial",
          "reply": "Kunci kebebasan finansial ada pada konsistensi menabung dan menghindari belanja impulsif."
        },
        {
          "id": "motor",
          "label": "\ud83d\udef5 Tanya Soal Motor",
          "reply": "Motor Ayah parkir di luar. Kamu bisa menaikinya dengan tombol Motor [V] di HUD, tapi pastikan bensin tidak kosong ya!"
        },
        {
          "id": "bye",
          "label": "\ud83d\udc4b Siap Ayah, terima kasih!",
          "reply": "Semangat menjalani harimu, nak!"
        }
      ],
      "dialogId": "dia_ayah_home"
    }
  ]
