    {
      "id": "npc_budi",
      "name": "Budi",
      "role": "Ketua Kelas",
      "assetId": "npc_sheet_friends",
      "color": 7288674,
      "x": 10,
      "y": 6,
      "dialog": "Halo! Pelajaran hari ini tentang pengelolaan uang saku dan investasi sederhana. Duduk yuk!",
      "choices": [
        {
          "id": "belajar",
          "label": "\ud83d\udcda Diskusi Soal Finansial",
          "reply": "Keren! Pak Guru tadi bilang kalau kita menabung rutin Rp5.000 sehari, setahun bisa dapat hampir dua juta rupiah!"
        },
        {
          "id": "kantin",
          "label": "\ud83c\udf5b Ajak ke Kantin",
          "reply": "Ayo ke kantin saat jam istirahat! Nasi uduk Bu Sri selalu laris manis."
        },
        {
          "id": "bye",
          "label": "\ud83d\udc4b Siap Budi!",
          "reply": "Sampai ketemu lagi!"
        }
      ]
    },
    {
      "id": "npc_sri",
      "name": "Bu Sri",
      "role": "Penjual Kantin",
      "assetId": "npc_sheet_vendors",
      "color": 14450338,
      "x": 22,
      "y": 4,
      "dialog": "Selamat datang di kantin sekolah! Mau makan siang apa hari ini nak?",
      "choices": [
        {
          "id": "menu",
          "label": "\ud83c\udf71 Buka Menu Kantin",
          "reply": "Silakan pilih makanan sehat berenergi di menu kantin!"
        },
        {
          "id": "hemat",
          "label": "\ud83d\udca1 Tips Jajan Sehat & Hemat",
          "reply": "Pilihlah makanan bernutrisi seperti nasi dan telur, hindari jajan manis berlebihan ya!"
        },
        {
          "id": "bye",
          "label": "\ud83d\udc4b Terima kasih Bu Sri!",
          "reply": "Sama-sama nak, selamat belajar!"
        }
      ]
    }
  ]
